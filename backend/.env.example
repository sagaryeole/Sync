# Database config
CTA_DATABASE_URL=sqlite:///./crypto.db

# Allowed CORS origins (comma-separated)
CTA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:3355

# Active symbols (comma-separated)
CTA_SYMBOLS=BTC,ETH,SOL,XRP,ADA,DOGE,AVAX,LINK

# Active feeds (comma-separated list of coinbase, binance, synthetic)
CTA_FEED_PROVIDERS=coinbase,binance,synthetic

# Connection settings
CTA_FEED_STALE_SECONDS=20
CTA_FEED_RECONNECT_BASE_SECONDS=1.0
CTA_FEED_RECONNECT_MAX_SECONDS=30.0
CTA_FEED_FAILBACK_SECONDS=120
CTA_BACKFILL_CANDLES=300

# Cadence settings
CTA_BROADCAST_HZ=4.0
CTA_CANDLE_FLUSH_SECONDS=5
CTA_ENGINE_TICK_SECONDS=1
CTA_STRATEGY_INTERVAL_SECONDS=15
CTA_EQUITY_SNAPSHOT_SECONDS=30

# Money settings
CTA_STARTING_CASH=100000.0
CTA_TAKER_FEE_BPS=10.0
CTA_MAKER_FEE_BPS=4.0
CTA_SLIPPAGE_BPS=1.5
CTA_IMPACT_NOTIONAL=50000.0
CTA_MIN_NOTIONAL=10.0

# Risk settings
CTA_MAX_OPEN_POSITIONS=4
CTA_MAX_POSITION_PCT=0.20
CTA_RISK_PER_TRADE_PCT=0.02
CTA_STOP_LOSS_PCT=0.02
CTA_TAKE_PROFIT_PCT=0.04
CTA_MAX_DRAWDOWN_PCT=0.25

# Retention settings
CTA_CANDLE_RETENTION_DAYS=7
CTA_EQUITY_RETENTION_HOURS=48
